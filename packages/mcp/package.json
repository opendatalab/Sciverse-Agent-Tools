{
  "name": "sciverse-mcp-server",
  "version": "0.4.3",
  "description": "SciVerse MCP server — exposes academic paper retrieval (search_papers / semantic_search / read_content) to MCP-compatible coding agents (Claude Code, Cursor, Codex CLI, Windsurf, ...).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/opendatalab/Sciverse-Agent-Tools/tree/main/packages/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opendatalab/Sciverse-Agent-Tools.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/opendatalab/Sciverse-Agent-Tools/issues"
  },
  "author": "SciVerse Platform Team",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "sciverse-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen-tools.mjs",
    "build": "npm run gen && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sciverse",
    "mcp",
    "model-context-protocol",
    "agent",
    "academic-papers",
    "rag",
    "claude-code",
    "cursor",
    "codex"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.4",
    "vitest": "^1.4",
    "yaml": "^2.4"
  }
}
